# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/

# Environment variables
.env
*.env.local

# IDE
.vscode/*
# ...pero la configuracion de depuracion si se comparte. Ojo: tiene que ser
# '.vscode/*' y no '.vscode/', porque git no puede reincluir un fichero
# cuyo directorio padre esta excluido.
!.vscode/launch.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
*.log

# Database
*.db
*.sqlite3
# Ficheros auxiliares que crea SQLite en modo WAL. Sin esto se colaban en los
# commits cada vez que la app tocaba la base.
*.db-wal
*.db-shm
*.db-journal
data/backups/

# Credentials / tokens
credentials.json
token.json
token.pickle
