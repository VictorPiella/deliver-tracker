# Copia este fichero a .env y ajusta lo que haga falta.
#   Windows:  Copy-Item .env.example .env
# .env está en .gitignore: no se sube al repo.

# Puerto en el que se ve el panel en el host (http://localhost:5000)
HOST_PORT=5000
DEBUG_PORT=5678

# Clave de sesión de Flask. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-in-production

TZ=Europe/Madrid

# true  -> usa los emails de ejemplo de app/mock_gmail.py (no toca tu Gmail)
# false -> Gmail real por OAuth; requiere data/credentials.json + data/token.json
#          (ver "Conectar Gmail real" en el README)
USE_MOCK_GMAIL=true

# Sincronización automática cada hora. En desarrollo suele estar mejor en false
# y sincronizar a mano con el botón "Escanear ahora".
ENABLE_BACKGROUND_WORKER=false

# --- Home Assistant (MQTT Discovery) ---
# Desactivado por defecto. Pon MQTT_ENABLED=true y apunta al broker de HA para
# que cada paquete aparezca como sensor.
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_DISCOVERY_PREFIX=homeassistant

# --- Depuración ---
# DEBUGPY=1 abre el puerto 5678 dentro del container para engancharse desde
# VS Code (F5 -> "Docker: adjuntar a deliver-tracker").
# DEBUGPY_WAIT=1 además congela el arranque hasta que te enganchas.
DEBUGPY=0
DEBUGPY_WAIT=0

# --- Ventana de busqueda en Gmail ---
# No limita cuanto puede durar un envio: solo cuanto correo antiguo se mira en
# cada pasada. La ventana normal es adaptativa (cubre el hueco desde el ultimo
# escaneo con exito), asi que un paron largo se recupera solo.
# Sube FIRST_SCAN_DAYS antes del primer escaneo si quieres una importacion
# inicial mas profunda (p.ej. 90).
GMAIL_FIRST_SCAN_DAYS=30
GMAIL_MIN_LOOKBACK_DAYS=14
GMAIL_MAX_LOOKBACK_DAYS=365
SYNC_INTERVAL_MINUTES=60

# --- Datos y seguridad ---
# Hora que se MUESTRA en el panel (lo guardado siempre es UTC).
DISPLAY_TZ=Europe/Madrid
# Los entregados se van solos a la papelera tras estos dias (0 lo desactiva).
# NO se borran: siguen recuperables desde la papelera.
PURGE_DELIVERED_AFTER_DAYS=30
# Copia diaria de la base en data/backups/
BACKUP_ENABLED=true
BACKUP_KEEP=7
# Contrasena del panel. Vacia = sin autenticacion (normal en una LAN de casa).
PANEL_USER=admin
PANEL_PASSWORD=
